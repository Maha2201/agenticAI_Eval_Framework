# Copy to .env (never commit .env). Values are read as environment variables.

# Base URL of the airline demo backend (openai-cs-agents-demo @ 46cc386)
AIRLINE_DEMO_URL=http://127.0.0.1:8000

# Only needed for LLM-judge metrics (llm_rubric) — not for deterministic metrics.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Corporate proxy / Zscaler: point at your exported root CA bundle (PEM).
# Used by the HTTP connector when connector.options.ca_bundle is "${AGENTIC_EVAL_CA_BUNDLE}".
AGENTIC_EVAL_CA_BUNDLE=

# Stop DeepEval sending telemetry.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
